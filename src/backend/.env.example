# Copy to .env and fill in real values. NEVER commit the real .env (NFR-SEC-2, SRS §5.4).
# See docs/ORCA_SRS_v1.1.docx §2.6 "Assumptions and Dependencies" for which of these
# are hard blockers vs. nice-to-have, and §6.4 "Dependencies Requiring Early Confirmation".

# --- Database (LLD §3) ---
DATABASE_URL=postgresql+asyncpg://orca:orca@localhost:5432/orca
# PostGIS must be enabled on this instance — see docs/ORCA_LLD_v1.0.docx §3 note.

# --- LLM provider (Planner entity-extraction + Synthesis composition — LLD §2.2, §2.7) ---
# Owner: P2. Confirm rate limits are sufficient for demo-day volume (SRS §6.4).
# Using Google Gemini (via Google AI Studio) since no team member has a paid
# LLM subscription — its free tier needs no card on file. See HLD v1.1 §6 and
# docs/CREDENTIALS.md #1 for setup / rationale. Groq is the documented backup
# if Gemini's free-tier rate limits get tight during demo rehearsal.
LLM_PROVIDER=google          # google | groq | anthropic | openai
LLM_API_KEY=

# --- Bhashini (ASR / TTS / Lang-ID — LLD §2.1) ---
# Owner: P2/P5. Confirm sandbox access early (SRS §6.4) — this is a hard external
# dependency and RISK-2 in the SRS risk register.
BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_BASE_URL=https://bhashini.gov.in/api

# --- Weather / marine data provider (LLD §2.9 WeatherDataAdapter) ---
# Owner: P3. Confirmed (docs/p3-data-source-spike.md §2). Fully free, no card:
#   * Open-Meteo Forecast API  — wind / precipitation / visibility (FR-WX-1).
#     No key, no signup. 10k calls/day (non-commercial).
#   * Open-Meteo Marine API    — wave height / direction / period (FR-WX-1).
#     No key, no signup.
#   * WeatherAPI.com           — govt severe-weather / cyclone alerts (FR-WX-2),
#     lat/lon native. Free key (email signup, no card): weatherapi.com/signup.aspx
#     -> forecast.json?...&alerts=yes. App still runs degraded without it.
#   * GDACS GeoRSS             — tropical-cyclone events, North Indian Ocean
#     (FR-WX-2). No key. Filter <gdacs:eventtype>TC</gdacs:eventtype>.
WEATHER_FORECAST_BASE_URL=https://api.open-meteo.com/v1
MARINE_API_BASE_URL=https://marine-api.open-meteo.com/v1
WEATHERAPI_BASE_URL=https://api.weatherapi.com/v1
WEATHERAPI_KEY=                    # weatherapi.com free key — alerts only; degraded (no alerts) without it
GDACS_BASE_URL=https://www.gdacs.org/xml
# IMD API (api.imd.gov.in) was evaluated for FR-WX-2 but dropped — its access
# needs ID proof + an institute permission letter + manual review (spike §2).
# WEATHER_API_KEY / WEATHER_API_BASE_URL — retired (was the OpenWeather plan);
# render.yaml still lists WEATHER_API_KEY as a secret, P1/P6 can drop it.

# --- INCOIS PFZ / oceanographic data (LLD §2.9 INCOISAdapter) ---
# Owner: P3. Confirmed (docs/p3-data-source-spike.md §3): no REST API, no key.
#   * SST / chlorophyll (FR-OCEAN-2): GeoServer WMS GetFeatureInfo (JSON) on
#     INCOIS_GEOSERVER_URL.
#   * PFZ advisory geometry (FR-OCEAN-1/3): GeoServer WFS GetFeature -> GeoJSON
#     on INCOIS_PFZ_WFS_URL (typeName PFZ_Automation:pfzlines). ~96 lines,
#     dated via Year+Julian_day. Fetch once/day and cache (~1.3 MB).
INCOIS_BASE_URL=https://incois.gov.in
INCOIS_GEOSERVER_URL=https://incois.gov.in/geoserver/PFZ-TUNA-SST-CHL
INCOIS_PFZ_WFS_URL=https://incois.gov.in/geoserver/PFZ_Automation/ows
OCEAN_PFZ_STALENESS_HOURS=48   # FR-OCEAN-4 — configurable; do not hardcode in ocean_agent.py
# Demo-resilience (#38): served as status='stale' when the live PFZ WFS is
# down and the per-day cache is cold. Refresh: scripts/refresh_pfz_snapshot.sh
INCOIS_PFZ_SNAPSHOT_PATH=./data/snapshots/pfz_latest.json.gz

# --- GIS boundary data (IMBL / MPA — LLD §2.9 GISBoundaryAdapter) ---
# Owner: P4. Confirm and download a working dataset on Day 1 (SRS RISK-4).
GIS_BOUNDARY_DATA_PATH=./data/gis/imbl_mpa_boundaries.geojson
IMBL_BUFFER_KM=5   # configurable per LLD §2.5 GeofencingAgent.check() — do not hardcode elsewhere

# --- "Which zones nearby?" listing (issue #174) ---
# Only used when the Planner marks a query scope="area" (asks which zones/
# regions, not one point). Point queries ignore these.
OCEAN_PFZ_NEARBY_RADIUS_KM=300
GEOFENCE_NEARBY_RADIUS_KM=150
NEARBY_ZONE_LIMIT=8

# --- Risk / Safety Agent (LLD §4.2 / Figure 2) ---
# Owner: P4. Marginal-conditions thresholds for the CAUTION branch: with no
# active weather alert and no geofence violation, wind or wave at/above these
# yields CAUTION instead of SAFE. The LLD specifies the branch but no numbers;
# these are team defaults, tune them with P3. Do not hardcode in
# risk_safety_agent.py.
RISK_MARGINAL_WIND_KMH=25
RISK_MARGINAL_WAVE_M=2.0

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=http://localhost:5173
