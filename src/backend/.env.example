# Copy to .env and fill in real values. NEVER commit the real .env (NFR-SEC-2, SRS §5.4).
# See docs/ORCA_SRS_v1.1.docx §2.6 "Assumptions and Dependencies" for which of these
# are hard blockers vs. nice-to-have, and §6.4 "Dependencies Requiring Early Confirmation".

# --- Database (LLD §3) ---
DATABASE_URL=postgresql+asyncpg://orca:orca@localhost:5432/orca
# PostGIS must be enabled on this instance — see docs/ORCA_LLD_v1.0.docx §3 note.

# --- LLM provider (Planner entity-extraction + Synthesis composition — LLD §2.2, §2.7) ---
# Owner: P2. Confirm rate limits are sufficient for demo-day volume (SRS §6.4).
LLM_PROVIDER=anthropic          # anthropic | openai
LLM_API_KEY=

# --- Bhashini (ASR / TTS / Lang-ID — LLD §2.1) ---
# Owner: P2/P5. Confirm sandbox access early (SRS §6.4) — this is a hard external
# dependency and RISK-2 in the SRS risk register.
BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_BASE_URL=https://bhashini.gov.in/api

# --- Weather / marine data provider (LLD §2.9 WeatherDataAdapter) ---
# Owner: P3. IMD public bulletins or an OpenWeather Marine API per HLD §6.
WEATHER_API_KEY=
WEATHER_API_BASE_URL=

# --- INCOIS PFZ / oceanographic data (LLD §2.9 INCOISAdapter) ---
# Owner: P3. Confirm API vs. scraping approach (SRS §6.4) on Day 1.
INCOIS_BASE_URL=https://incois.gov.in

# --- GIS boundary data (IMBL / MPA — LLD §2.9 GISBoundaryAdapter) ---
# Owner: P4. Confirm and download a working dataset on Day 1 (SRS RISK-4).
GIS_BOUNDARY_DATA_PATH=./data/gis/imbl_mpa_boundaries.geojson
IMBL_BUFFER_KM=5   # configurable per LLD §2.5 GeofencingAgent.check() — do not hardcode elsewhere

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=http://localhost:5173
