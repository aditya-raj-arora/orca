# Copy to .env and fill in real values. NEVER commit the real .env (NFR-SEC-2, SRS §5.4).
# See docs/ORCA_SRS_v1.1.docx §2.6 "Assumptions and Dependencies" for which of these
# are hard blockers vs. nice-to-have, and §6.4 "Dependencies Requiring Early Confirmation".

# --- Database (LLD §3) ---
DATABASE_URL=postgresql+asyncpg://orca:orca@localhost:5432/orca
# PostGIS must be enabled on this instance — see docs/ORCA_LLD_v1.0.docx §3 note.

# --- LLM provider (Planner entity-extraction + Synthesis composition — LLD §2.2, §2.7) ---
# Owner: P2. Confirm rate limits are sufficient for demo-day volume (SRS §6.4).
# Using Google Gemini (via Google AI Studio) since no team member has a paid
# LLM subscription — its free tier needs no card on file. See HLD v1.1 §6 and
# docs/CREDENTIALS.md #1 for setup / rationale. Groq is the documented backup
# if Gemini's free-tier rate limits get tight during demo rehearsal.
LLM_PROVIDER=google          # google | groq | anthropic | openai
LLM_API_KEY=

# --- Bhashini (ASR / TTS / Lang-ID — LLD §2.1) ---
# Owner: P2/P5. Confirm sandbox access early (SRS §6.4) — this is a hard external
# dependency and RISK-2 in the SRS risk register.
BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_BASE_URL=https://bhashini.gov.in/api

# --- Weather / marine data provider (LLD §2.9 WeatherDataAdapter) ---
# Owner: P3. Confirmed (docs/p3-data-source-spike.md §2). Fully free, no card:
#   * Open-Meteo Forecast API  — wind / precipitation / visibility (FR-WX-1).
#     No key, no signup. 10k calls/day (non-commercial).
#   * Open-Meteo Marine API    — wave height / direction / period (FR-WX-1).
#     No key, no signup.
#   * IMD API (api.imd.gov.in) — official cyclone track + district / subdivision
#     warnings + nowcast + coastal/sea bulletins (FR-WX-2). Free, no card, BUT
#     needs a free account + API key from api.imd.gov.in/register.php.
WEATHER_FORECAST_BASE_URL=https://api.open-meteo.com/v1
MARINE_API_BASE_URL=https://marine-api.open-meteo.com/v1
IMD_API_BASE_URL=https://api.imd.gov.in/api/v1
IMD_API_KEY=                      # from api.imd.gov.in registration — warnings only; app still runs (degraded) without it
# WEATHER_API_KEY / WEATHER_API_BASE_URL — retired: the OpenWeather plan was
# dropped for a keyless stack. render.yaml still lists WEATHER_API_KEY as a
# secret; P1/P6 can drop it (spike §4.1).

# --- INCOIS PFZ / oceanographic data (LLD §2.9 INCOISAdapter) ---
# Owner: P3. Confirmed (docs/p3-data-source-spike.md §3): no REST API, no key.
# SST/chl via GeoServer WMS GetFeatureInfo (JSON); PFZ advisory geometry source
# still open (spike §4.2). INCOIS_BASE_URL is just a fetch base.
INCOIS_BASE_URL=https://incois.gov.in
INCOIS_GEOSERVER_URL=https://incois.gov.in/geoserver/PFZ-TUNA-SST-CHL
OCEAN_PFZ_STALENESS_HOURS=48   # FR-OCEAN-4 — configurable; do not hardcode in ocean_agent.py

# --- GIS boundary data (IMBL / MPA — LLD §2.9 GISBoundaryAdapter) ---
# Owner: P4. Confirm and download a working dataset on Day 1 (SRS RISK-4).
GIS_BOUNDARY_DATA_PATH=./data/gis/imbl_mpa_boundaries.geojson
IMBL_BUFFER_KM=5   # configurable per LLD §2.5 GeofencingAgent.check() — do not hardcode elsewhere

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=http://localhost:5173
