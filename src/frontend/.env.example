# ==============================================================================
# ORCA Frontend Environment Variables
# ==============================================================================
# In local development (npm run dev), these can usually be left empty because
# Vite automatically proxies relative requests to http://localhost:8000.
#
# For production builds, set these to the absolute URL of the deployed backend.
# Example:
# VITE_API_BASE_URL=https://api.orca-marine.org
# VITE_WS_BASE_URL=wss://api.orca-marine.org
# ==============================================================================

VITE_API_BASE_URL=
VITE_WS_BASE_URL=
